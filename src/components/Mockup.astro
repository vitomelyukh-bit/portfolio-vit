---
// Browser con anteprima della pagina intera (scorre al passaggio del mouse) + telefono sovrapposto.
interface Props {
  slug: string;
  name: string;
  url: string;
  eager?: boolean;
}
const { slug, name, url, eager = false } = Astro.props;
const host = new URL(url).hostname.replace(/^www\./, '');
const loading = eager ? 'eager' : 'lazy';
---

<div class="mockup">
  <div class="browser">
    <div class="browser__bar">
      <span class="browser__dots"><i></i><i></i><i></i></span>
      <span class="browser__url">{host}</span>
    </div>
    <div class="browser__screen">
      <img src={`/shots/${slug}/page.webp`} alt={`Pagina del sito ${name}`} width="960" loading={loading} decoding="async" />
    </div>
  </div>
  <div class="phone">
    <img src={`/shots/${slug}/mobile.webp`} alt={`${name} su smartphone`} width="585" height="1266" loading={loading} decoding="async" />
  </div>
</div>
